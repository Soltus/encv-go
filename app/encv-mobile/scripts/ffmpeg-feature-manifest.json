        "fftools/resources/graph.html.c"
      ]
    },
    "libffprobe.so": {
      "core": [
        "fftools/ffprobe.c",
        "fftools/cmdutils.c",
        "fftools/opt_common.c"
      ],
      "textformat_shared": true
    }
