{
  "name": "encv-go-mobile",
  "version": "1.0.0",
  "description": "ENCV-go Mobile Frontend (Capacitor + Ionic Vue)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "capacitor:copy:after": "node scripts/sync-native.mjs",
    "check:kotlin": "node scripts/check-kotlin.mjs",
    "sync:android": "node scripts/sync-native.mjs",
    "rebuild:android": "echo 'To rebuild android/ from scratch: rm -rf android && npx cap add android && npx cap sync android && npx @trapezedev/configure run trapeze.yaml --android-project android'",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ajuarezso/capacitor-high-refresh-rate": "^0.6.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/vue": "^8.8.7",
    "@ionic/vue-router": "^8.8.7",
    "@tanstack/vue-virtual": "^3.13.26",
    "@tdesign-vue-next/chat": "0.5.0-alpha.11",
    "artplayer": "^5.4.0",
    "dexie": "^4.4.4",
    "ionicons": "^8.0.13",
    "jszip": "^3.10.1",
    "markstream-vue": "1.0.1-beta.5",
    "pinia": "^3.0.4",
    "vconsole": "^3.15.1",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "sirv": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.10"
  }
}
