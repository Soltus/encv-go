{
  "name": "encv-go-mobile",
  "version": "1.0.0",
  "type": "module",
  "description": "ENCV-go Mobile Frontend (Capacitor + Ionic Vue)",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "capacitor:copy:after": "bun scripts/sync-native.ts",
    "check:kotlin": "bun scripts/check-kotlin.ts",
    "biome:stats": "bun scripts/biome-stats.ts",
    "pw:smoke": "bun pw-smoke.ts",
    "pw:direct": "bun pw-direct.ts",
    "pw:debug": "bun pw-debug.ts",
    "check:i18n:full": "cd ../.. && python3 scripts/i18n-tool.py scan --app encv-mobile && python3 scripts/i18n-tool.py var-check --app encv-mobile",
    "sync:android": "bun scripts/sync-native.ts",
    "rebuild:android": "echo 'To rebuild android/ from scratch: rm -rf android && npx cap add android && npx cap sync android && npx @trapezedev/configure run trapeze.yaml --android-project android'",
    "test": "pnpm test:cypress:component",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:full": "ENCV_TEST_FULL=1 vitest run",
    "test:unit:coverage": "ENCV_TEST_FULL=1 vitest run --coverage",
    "test:cypress": "PM2_HOME=/tmp/cypress-pm2 CYPRESS_INSTALL_BINARY=0 xvfb-run -a --server-args=\"-screen 0 1024x768x24\" cypress run --browser electron",
    "test:cypress:open": "PM2_HOME=/tmp/cypress-pm2 CYPRESS_INSTALL_BINARY=0 xvfb-run -a --server-args=\"-screen 0 1024x768x24\" cypress open --browser electron",
    "test:cypress:component": "PM2_HOME=/tmp/cypress-pm2 CYPRESS_INSTALL_BINARY=0 xvfb-run -a --server-args=\"-screen 0 1024x768x24\" cypress run --component --browser electron",
    "test:cypress:full": "ENCV_TEST_FULL=1 PM2_HOME=/tmp/cypress-pm2 CYPRESS_INSTALL_BINARY=0 xvfb-run -a --server-args=\"-screen 0 1024x768x24\" cypress run --component --browser electron",
    "test:cypress:e2e": "PM2_HOME=/tmp/cypress-pm2 CYPRESS_INSTALL_BINARY=0 xvfb-run -a --server-args=\"-screen 0 1024x768x24\" cypress run --e2e --browser electron",
    "test:visual": "PM2_HOME=/tmp/cypress-pm2 PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright npx playwright test --config playwright.config.mjs",
    "test:visual:update": "PM2_HOME=/tmp/cypress-pm2 PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright npx playwright test --config playwright.config.mjs --update-snapshots",
    "check:i18n": "cd ../.. && python3 scripts/i18n-tool.py scan --app encv-mobile",
    "i18n:stats": "cd ../.. && python3 scripts/i18n-tool.py stats --app encv-mobile",
    "i18n:var-check": "cd ../.. && python3 scripts/i18n-tool.py var-check --app encv-mobile",
    "i18n:dup": "cd ../.. && python3 scripts/i18n-tool.py dup --app encv-mobile",
    "i18n:en-check": "cd ../.. && python3 scripts/i18n-tool.py en-check --app encv-mobile",
    "i18n:gen-types": "cd ../.. && python3 scripts/i18n-tool.py gen-types --app encv-mobile",
    "i18n:db-init": "cd ../.. && python3 scripts/i18n-tool.py db-init --app encv-mobile",
    "i18n:find": "cd ../.. && python3 scripts/i18n-tool.py find-key",
    "prebuild": "pnpm check:i18n:full",
    "pretypecheck": "pnpm check:i18n:full",
    "pretest:unit": "pnpm check:i18n:full",
    "pretest": "pnpm check:i18n:full"
  },
  "dependencies": {
    "@ajuarezso/capacitor-high-refresh-rate": "^0.6.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/vue": "catalog:",
    "@ionic/vue-router": "catalog:",
    "@tanstack/vue-virtual": "^3.13.26",
    "@tdesign-vue-next/chat": "0.5.0-alpha.11",
    "artplayer": "^5.4.0",
    "dexie": "^4.4.4",
    "ionicons": "catalog:",
    "jszip": "^3.10.1",
    "leafer-ui": "^2.1.10",
    "markstream-vue": "1.0.1-beta.5",
    "matter-js": "^0.20.0",
    "pinia": "^3.0.4",
    "vconsole": "^3.15.1",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "1.61.1",
    "@types/matter-js": "^0.20.2",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "cypress": "^15.17.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "sass-embedded": "^1.100.0",
    "sirv": "^3.0.2",
    "typescript": "catalog:",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
    "vitest": "^4.1.7",
    "vue-tsc": "catalog:"
  }
}
