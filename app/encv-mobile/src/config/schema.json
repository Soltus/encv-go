{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Soltus/encv-go/internal/config/config",
  "$ref": "#/$defs/Config",
  "$defs": {
    "AdminServer": {
      "properties": {
        "password": {
          "type": "string",
          "description": "管理员密码，留空则禁用登录"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["password"],
      "description": "--- 管理后台服务器 设置 ---"
    },
    "AudioPluginConfig": {
      "properties": {
        "ext": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["ext"]
    },
    "Config": {
      "properties": {
        "password": {
          "type": "string",
          "description": "--- 全局设置 ---\nPassword 用于加密和解密视频文件，请务必设置一个强密码。"
        },
        "recover": {
          "type": "boolean",
          "description": "Recover 在解密时是否尝试覆盖已有文件。"
        },
        "output_path": {
          "type": "string",
          "description": "--- 加密/解密设置 ---\nOutputPath 加密后的文件输出目录。"
        },
        "plugin_settings": {
          "properties": {
            "video": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/video/video-plugin-config",
              "$ref": "#/$defs/VideoPluginConfig"
            },
            "audio": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/audio/audio-plugin-config",
              "$ref": "#/$defs/AudioPluginConfig"
            },
            "image": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/image/image-plugin-config",
              "$ref": "#/$defs/ImagePluginConfig"
            },
            "wps": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/wps/wps-plugin-config",
              "$ref": "#/$defs/WPSPluginConfig"
            },
            "pdf": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/pdf/pdf-plugin-config",
              "$ref": "#/$defs/PDFPluginConfig"
            },
            "text": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Soltus/encv-go/internal/v2/plugins/text/text-plugin-config",
              "$ref": "#/$defs/TextPluginConfig"
            },
            "alist_encrypt": {
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "启用 Alist-Encrypt 文件检测与解密功能"
                },
                "suffix": {
                  "type": "string",
                  "default": ".bin",
                  "description": "Alist-Encrypt 加密文件的后缀名（需以 . 开头）"
                },
                "default_password": {
                  "type": "string",
                  "default": "",
                  "description": "默认解密密码，留空则每次需要手动输入"
                },
                "algorithm": {
                  "type": "string",
                  "enum": ["AES-128-CTR"],
                  "x-enum-labels": {
                    "AES-128-CTR": "AES-128-CTR"
                  },
                  "x-enum-descriptions": {
                    "AES-128-CTR": "当前仅支持此算法"
                  },
                  "default": "AES-128-CTR",
                  "description": "加密算法（当前仅支持 AES-128-CTR）"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": ["enabled", "suffix"],
              "description": "--- Alist-Encrypt 配置 ---\nAlist 文件加密格式的客户端检测与流式解密配置。"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "description": "插件专属配置。键是插件名，值是该插件的配置对象。"
        },
        "server": {
          "$ref": "#/$defs/HttpServer"
        },
        "admin": {
          "$ref": "#/$defs/AdminServer"
        },
        "webdav": {
          "$ref": "#/$defs/WebdavServer"
        },
        "proxy": {
          "$ref": "#/$defs/OpenlistProxyServer"
        },
        "log": {
          "$ref": "#/$defs/LogConfig",
          "description": "--- 日志设置 ---\nLog 配置结构化日志的输出级别和文件路径。"
        },
        "database": {
          "$ref": "#/$defs/DatabaseConfig",
          "description": "--- 数据库设置 ---\nDatabase 数据库存储引擎配置，支持 SQLite / Turso / LibSQL。"
        },
        "agent_settings": {
          "properties": {
            "openai_api_key": {
              "type": "string",
              "secret": true,
              "description": "OpenAI API Key（仅存本机，不上传）",
              "x-platform": "both"
            },
            "openai_base_url": {
              "type": "string",
              "default": "https://api.openai.com/v1",
              "description": "OpenAI API Base URL",
              "x-platform": "both"
            },
            "openai_model": {
              "type": "string",
              "default": "gpt-4o-mini",
              "x-dynamic-options": "/agent-api/api/models",
              "description": "OpenAI 模型选择（从供应商 API 动态获取）",
              "x-platform": "both"
            },
            "openlist_base_url": {
              "type": "string",
              "default": "http://127.0.0.1:5244",
              "description": "OpenList 服务地址（agent 通过此地址调用 /api/ext/* 工具端点）",
              "x-platform": "both"
            },
            "openlist_token": {
              "type": "string",
              "secret": true,
              "description": "OpenList admin token（用于 agent 调 /api/ext/* 时的 Authorization 头）",
              "x-platform": "both"
            },
            "default_container_version": {
              "type": "integer",
              "default": 1,
              "description": "默认容器版本（覆盖插件的 DefaultVersion）",
              "x-platform": "both"
            },
            "enabled_tools": {
              "type": "array",
              "default": ["list_files", "read_file", "delete_file", "exec_command"],
              "description": "启用的工具白名单（默认 list_files / read_file / delete_file / exec_command）",
              "x-platform": "both"
            },
            "system_prompt": {
              "type": "string",
              "format": "multiline",
              "default": "你是 ENCV 助手，帮助用户管理加密容器和文件。\n\n工具使用原则：\n1. 优先使用只读工具（list_mounts / list_files / read_file / stat_file / get_storage_info）了解文件状态，这些操作无需用户确认。\n2. 需要加密/解密文件时使用 {plugin}_encrypt / {plugin}_decrypt 工具，这些会改变文件状态，必须等待用户确认。\n3. 加密容器扩展名由 plugin.GetContainerExtension() 动态返回：video→.sccgv, audio→.sccga, image→.sccgi, text→.sccgt, pdf→.sccgp, wps→.sccgw。alist_encrypt 兼容 plugin 返回 .encv（仅 alist 历史格式）。使用 stat_file 可看到 is_encrypted=true 标记。\n4. 用户问「我的 X 文件在哪」「目录下有什么」「文件多大」时，调用 list_mounts → list_files 链式查询；用户问「文件里写什么」时用 read_file。\n5. 每次工具调用前用一句话说明你要做什么，不要连续触发多个写操作工具。",
              "description": "Agent 系统提示词（multiline）",
              "x-platform": "both"
            },
            "max_tool_calls_per_turn": {
              "type": "integer",
              "default": 10,
              "description": "单轮最大工具调用次数（防无限递归）",
              "x-platform": "both"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "description": "--- AI 助手设置 ---\nAgent 服务的 OpenAI / OpenList 接入信息和工具白名单。"
        },
        "$schema": {
          "type": "string",
          "format": "uri",
          "description": "The JSON Schema file for validation, used by editors."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["password", "recover", "output_path", "plugin_settings", "server", "admin", "webdav", "proxy", "log", "database"],
      "description": "Config 是应用程序的顶层配置结构，包含所有子模块的配置。"
    },
    "HttpServer": {
      "properties": {
        "port": {
          "type": "integer",
          "description": "encv HTTP 服务器的端口，请不要填写 encv Webdav Server、 OpenList 或其他已使用的端口"
        },
        "dir": {
          "type": "string",
          "description": "文件系统的根目录（例如 /path/to/your/files），支持相对路径"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["port", "dir"],
      "description": "--- 内置HTTP服务器 设置 ---"
    },
    "ImagePluginConfig": {
      "properties": {
        "ext": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["ext"]
    },
    "LogConfig": {
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "x-enum-labels": {
            "debug": "DEBUG",
            "info": "INFO",
            "warn": "WARN",
            "error": "ERROR"
          },
          "x-enum-descriptions": {
            "debug": "详细的插件匹配、文件处理等调试信息",
            "info": "关键操作信息和服务状态",
            "warn": "潜在问题但不影响运行的警告",
            "error": "仅输出错误信息"
          },
          "default": "info",
          "description": "日志级别: debug, info, warn, error\n设置为 debug 可以看到详细的插件匹配、文件处理等调试信息。\ninfo 级别会输出关键操作信息和服务状态。\nwarn 输出潜在问题但不影响运行的警告。\nerror 只输出错误信息。"
        },
        "file": {
          "type": "string",
          "description": "日志文件路径，为空则只输出到控制台\n如果指定了文件路径，控制台输出带颜色的文本格式，文件输出 JSON 格式。\n支持相对路径（相对于可执行文件）和绝对路径。\n示例: \"encv.log\" 或 \"D:/logs/encv.log\""
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["level", "file"],
      "description": "--- 日志配置 ---"
    },
    "DatabaseConfig": {
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["sqlite", "turso", "libsql"],
          "x-enum-labels": {
            "sqlite": "SQLite（推荐，稳定可靠）",
            "turso": "Turso / LibSQL（高性能，支持 MVCC 并发）",
            "libsql": "LibSQL（同 Turso 引擎）"
          },
          "default": "sqlite",
          "description": "存储引擎：\n- sqlite: SQLite，稳定可靠，单写者\n- turso: Turso / LibSQL，高性能，支持 MVCC 并发写入\n切换引擎后需要重启应用生效。"
        },
        "path": {
          "type": "string",
          "description": "数据库文件路径（仅 sqlite/turso 本地模式）\n留空则使用默认路径。"
        },
        "turso_sync_url": {
          "type": "string",
          "description": "Turso 同步 URL（仅 turso 远程模式）\n例如：libsql://your-db.turso.io"
        },
        "turso_auth_token": {
          "type": "string",
          "secret": true,
          "description": "Turso 认证令牌（仅 turso 远程模式）"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["engine"],
      "description": "--- 数据库配置 ---"
    },
    "OpenlistProxyServer": {
      "properties": {
        "sites": {
          "additionalProperties": {
            "$ref": "#/$defs/ProxySiteConfig"
          },
          "type": "object"
        },
        "disable_signature_verification": {
          "type": "boolean",
          "description": "禁用签名，目前没发现这个值有什么影响"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["sites", "disable_signature_verification"],
      "description": "--- Openlist 代理服务器设置 ---"
    },
    "PDFPluginConfig": {
      "properties": {
        "ext": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["ext"]
    },
    "ProxySiteConfig": {
      "properties": {
        "host": {
          "type": "string",
          "description": "OpenList 的主机，一般是 IP 或者域名，加上端口号，比如 localhost:5244"
        },
        "description": {
          "type": "string",
          "description": "站点描述，可选，用于用户自己标识区分"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["host"]
    },
    "TextPluginConfig": {
      "properties": {
        "ext": {
          "type": "string"
        },
        "custom_text_extensions": {
          "type": "string",
          "default": "",
          "description": "自定义文本预览扩展名，逗号分隔（如 log,ini,cfg,toml）。将追加到内置文本扩展名列表中用于文件预览。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["ext"]
    },
    "VideoPluginConfig": {
      "properties": {
        "ext": {
          "type": "string",
          "x-platform": "both"
        },
        "container_chunk_size_mb": {
          "type": "integer",
          "x-platform": "both"
        },
        "light_container_main_chunk_enabled": {
          "type": "boolean",
          "x-platform": "both"
        },
        "track_extensions": {
          "type": "string",
          "x-platform": "both"
        },
        "keep_mkv_for_mkv_source": {
          "type": "boolean",
          "x-platform": "both"
        },
        "verify_after_pack": {
          "type": "boolean",
          "x-platform": "both"
        },
        "plugin_cache_dir": {
          "type": "string",
          "x-platform": "both"
        },
        "skip_merge_for_split_mkv": {
          "type": "boolean",
          "x-platform": "both"
        },
        "allow_no_reencode": {
          "type": "boolean",
          "default": false,
          "x-platform": "both",
          "x-v4": true
        },
        "default_stream_preset": {
          "type": "string",
          "default": "balanced",
          "enum": ["balanced", "quality", "high_quality"],
          "x-enum-labels": {
            "balanced": "平衡（推荐）",
            "quality": "高质量",
            "high_quality": "极致画质"
          },
          "x-enum-descriptions": {
            "balanced": "画质较好、体积适中、延迟可接受",
            "quality": "画质更好，体积稍大，延迟略高",
            "high_quality": "画质最佳，体积控制好，但延迟更高"
          },
          "x-platform": "mobile",
          "x-v4": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ext",
        "container_chunk_size_mb",
        "light_container_main_chunk_enabled",
        "track_extensions",
        "keep_mkv_for_mkv_source",
        "verify_after_pack",
        "plugin_cache_dir",
        "skip_merge_for_split_mkv"
      ]
    },
    "WPSPluginConfig": {
      "properties": {
        "ext": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["ext"]
    },
    "WebdavServer": {
      "properties": {
        "root": {
          "type": "string",
          "description": "路由（例如 /webdav/）"
        },
        "dir": {
          "type": "string",
          "description": "文件系统的根目录（例如 /path/to/your/files），而不是 WebDAV 的路由前缀（例如 /webdav/）"
        },
        "username": {
          "type": "string",
          "description": "WebDAV 基础认证的用户名"
        },
        "password": {
          "type": "string",
          "description": "WebDAV 基础认证的密码"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["root", "dir", "username", "password"],
      "description": "--- WebDAV 服务器设置 ---"
    }
  }
}
