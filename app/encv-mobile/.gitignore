node_modules
dist
dist-ssr
*.local

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ffmpeg-builder v3 编译产物（含 .so 静态库 / 源码 clone / ffmpeg 解压目录）
# 必须在 git 排除外！否则 git clone x264 后 .git/index 会把 x264 路径加为 gitlink
# 触发 CI 'fatal: no submodule mapping found in .gitmodules' 错误
build/ffmpeg/

android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
ios/

# 编译期 jniLibs 由 build-ffmpeg-lib.yml release 拉取，主工作流不 commit
android/app/src/main/jniLibs/

android-overlay/app/src/main/jniLibs/

encv-go-arm64

# Cypress 视觉回归产物（compareSnapshot: baseline 入库作对比基，diff/运行截图忽略）
cypress/visual/
cypress/screenshots/
cypress/videos/
# Playwright 产物
test-results/
playwright-report/

# ---- 插件构建产物（plugin-* 共用，集中在此，避免各插件各自维护 .gitignore） ----
plugin-*/build/
# 前端 web 构建产物拷贝进插件 assets（由 build-android*.sh 生成）
plugin-*/src/main/assets/*/
# openlist 插件：下载/解出的原生库与提取的类 jar
plugin-openlist/src/main/jniLibs/
plugin-openlist/openlist-classes.jar
plugin-openlist/libs/openlist-classes.jar

# release 签名 keystore（ensure_android_keystore 生成，含密钥，禁止入库）
keystore/

# 本地构建门禁日志（build-android*.sh 的 run_gradle 输出）
**/build-logs/