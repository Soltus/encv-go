{
  "name": "@encv/shared-components",
  "version": "1.0.0",
  "description": "Shared page components and utilities for ENCV apps",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./views/*": "./src/views/*",
    "./composables/*": "./src/composables/*",
    "./plugins/*": "./src/plugins/*",
    "./components/*": "./src/components/*",
    "./api/*": "./src/api/*",
    "./config/*": "./src/config/*",
    "./constants/*": "./src/constants/*",
    "./features/*": "./src/features/*",
    "./utils/*": "./src/utils/*",
    "./theme/*": "./src/theme/*",
    "./styles/*": "./src/styles/*",
    "./i18n/*": "./src/i18n/*",
    "./types/*": "./src/types/*",
    "./stores/*": "./src/stores/*",
    "./router": "./src/router/index.ts",
    "./lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/vue": "^8.8.7",
    "@ionic/vue-router": "^8.8.7",
    "@tanstack/vue-virtual": "^3.13.26",
    "ionicons": "^8.0.13",
    "jszip": "^3.10.1",
    "leafer-ui": "^2.1.10",
    "matter-js": "^0.20.0",
    "pinia": "^3.0.4",
    "vconsole": "^3.15.1",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^3.0.4",
    "dexie": "^4.4.4",
    "markstream-vue": "1.0.1-beta.5"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vue-tsc": "^2.2.10"
  }
}
