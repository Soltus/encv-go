#!/usr/bin/env bash
#
# codemogger auto-reindex shim
#
# Transparent wrapper around the real `codemogger` CLI. Before any *read*
# query (references / context / search) it runs an incremental `index` of the
# relevant codebase so the agent never sees stale data and never has to
# "remember" to re-index. Freshness is enforced at the tool layer, not by
# agent discipline.
#
# Installed by apply.sh over the `codemogger` entrypoint. The real CLI is the
# bundled `dist/cli.mjs`; this shim just calls it (no recursion).
#
# Env overrides:
#   CODEMOGGER_NO_AUTOINDEX=1   disable auto-reindex (pass-through only)
#   CODEMOGGER_CLI=<path>       explicit path to the real dist/cli.mjs
#
# --- UX pitfall mitigations layered on top of `references` -------------------
#   坑1 (symbol-name exact match): `references <sym>` is an exact match on the
#        imported symbol name. Guessing the wrong name yields "No imports found"
#        (e.g. the real export is `useRunSummariesSingleton`, not
#         `useRunSummaries`; `lib/taskTypeLabel.ts` exports `getTaskTypeLabel`,
#         not `taskTypeLabel`). Mitigation: when a bare `references <sym>` finds
#         nothing AND a file named `<sym>.{ts,tsx,vue}` exists under the
#         codebase root, re-query with `--module "@/<relpath>"` (module-level
#         match is name-agnostic and catches every importer). The assumption is
#         that the `@/` alias root equals the codebase root (true for
#         app/encv-mobile/src). A stderr hint announces the fallback.
#   坑2 (--file needs an absolute path): `references <file> --file` lists the
#        file's own imports, but `imports.file_path` stores absolute paths, so a
#        relative path silently matches nothing. Mitigation: rewrite a relative
#        target into an absolute path before invoking the real CLI.
#   坑3 (static imports only): the walker resolves only static `import`/
#        `export ... from`. Dynamic `import()` / string specifiers are invisible.
#        This is a parser limitation in cli.mjs and is NOT mitigated here (would
#        require patching the upstream walker). Callers should corroborate with
#        grep for dynamic-import cases.
#
set -euo pipefail

# --- resolve the real CLI entrypoint -----------------------------------------
REAL_CLI="${CODEMOGGER_CLI:-}"
if [ -z "$REAL_CLI" ]; then
  _bin="$(command -v codemogger 2>/dev/null || true)"
  if [ -n "$_bin" ]; then
    _resolved="$(readlink -f "$_bin" 2>/dev/null || echo "$_bin")"
    case "$_resolved" in
      */dist/cli.mjs) REAL_CLI="$_resolved" ;;
      *) REAL_CLI="/usr/local/lib/node_modules/codemogger/dist/cli.mjs" ;;
    esac
  else
    REAL_CLI="/usr/local/lib/node_modules/codemogger/dist/cli.mjs"
  fi
fi

NO_AUTOINDEX="${CODEMOGGER_NO_AUTOINDEX:-0}"

# --- scan global options that may appear anywhere ----------------------------
DB_PATH=""
HAS_FILE=0
HAS_MODULE=0
prev=""
for a in "$@"; do
  if [ "$prev" = "--db" ]; then DB_PATH="$a"; fi
  case "$a" in
    --db=*) DB_PATH="${a#--db=}" ;;
    --file) HAS_FILE=1 ;;
    --module) HAS_MODULE=1 ;;
  esac
  prev="$a"
done

# --- resolve codebase root dir (shared by reindex + 坑1 fallback) ------------
DIR="."
if [ -n "$DB_PATH" ]; then
  # db path is <dir>/.codemogger/index.db
  DIR="$(cd "$(dirname "$(dirname "$DB_PATH")")" && pwd)"
fi

SUBCMD="${1:-}"

# 坑2: --file with a relative target -> rewrite to absolute (imports.file_path
# is absolute, so a relative path silently matches nothing).
if [ "$SUBCMD" = "references" ] && [ "$HAS_FILE" = "1" ]; then
  tgt="${2:-}"
  case "$tgt" in
    ""|/*) ;;   # empty or already absolute
    *)
      if [ -e "$tgt" ]; then
        tgt="$(cd "$(dirname "$tgt")" && pwd)/$(basename "$tgt")"
        set -- "$1" "$tgt" "${@:3}"
      fi
      ;;
  esac
fi

maybe_reindex() {
  [ "$NO_AUTOINDEX" = "1" ] && return 0
  case "$SUBCMD" in
    references|context|search) ;;   # read queries -> refresh first
    *) return 0 ;;                  # index/list/mcp/help -> pass through
  esac

  if [ -n "$DB_PATH" ]; then
    node "$REAL_CLI" index "$DIR" --db "$DB_PATH" >/dev/null 2>&1 || true
  else
    node "$REAL_CLI" index "$DIR" >/dev/null 2>&1 || true
  fi
  return 0
}

# 坑1: bare `references <sym>` with no result -> fall back to module-level match
# by locating a same-named file under the codebase root.
if [ "$SUBCMD" = "references" ] && [ "$HAS_FILE" = "0" ] && [ "$HAS_MODULE" = "0" ]; then
  maybe_reindex
  sym="${2:-}"
  out="$(node "$REAL_CLI" "$@" 2>&1)" || true
  if echo "$out" | grep -q "No imports found for:"; then
    hit="$(find "$DIR" \( -path '*/node_modules/*' -o -path '*/.git/*' \) -prune -o \
            \( -name "$sym.ts" -o -name "$sym.tsx" -o -name "$sym.vue" \) -print 2>/dev/null | head -1)"
    if [ -n "$hit" ]; then
      rel="${hit#$DIR/}"; rel="${rel%.*}"   # strip root prefix + extension
      mod="@/${rel}"                         # assume @/ alias root == codebase root
      echo "(codemogger-shim: symbol '$sym' had no importers; fell back to module '$mod')" >&2
      node "$REAL_CLI" references "$mod" --module "${@:3}" 2>&1 || true
      exit 0
    fi
  fi
  echo "$out"
  exit 0
fi

# --- refactoring helpers (alias-aware impact + leak detection) ----------------
# These two subcommands turn codemogger's import graph into a refactoring
# assistant for the encv-mobile -> @encv/shared-components lift.
#
#   impact <target>   alias-agnostic blast radius of a module/symbol. Closes the
#                     gap noted in README ("--module matches the specifier
#                     EXACTLY; @/stores/taskStore vs @encv/shared-components/...
#                     are distinct rows"): it queries BOTH alias forms and merges
#                     the importer lists, so a lift/decouple never misses one side.
#   leaks  [dir]      list every shared->app reverse `@/` import under <dir>
#                     (default: indexed codebase root). Directly verifies the
#                     "shared layer must not depend on the app layer" invariant
#                     after a decoupling pass.

if [ "$SUBCMD" = "impact" ]; then
  maybe_reindex
  target="${2:-}"
  if [ -z "$target" ]; then
    echo "usage: codemogger impact <module|symbol>" >&2
    echo "  e.g. codemogger impact @/api/encv" >&2
    echo "       codemogger impact @encv/shared-components/api/encv" >&2
    echo "       codemogger impact useTaskStore" >&2
    exit 2
  fi
  # derive the alias-variant specifier so both forms are queried
  alt=""
  case "$target" in
    @/*)                        alt="@encv/shared-components/${target#@/}" ;;
    @encv/shared-components/*)  alt="@/${target#@encv/shared-components/}" ;;
  esac
  # IMPORTANT: pass --db through. The MCP server always sets --db to pin the
  # index, but its cwd is not fixed, so a bare `references` (which defaults the
  # db to cwd) would read the wrong index. Carry DB_PATH explicitly.
  dbarg=()
  if [ -n "$DB_PATH" ]; then dbarg=(--db "$DB_PATH"); fi
  if [ "${target#@}" != "$target" ]; then
    echo "== importers of module '$target' (exact) =="
    node "$REAL_CLI" references "$target" --module "${dbarg[@]}" 2>&1 || true
    if [ -n "$alt" ]; then
      echo "== importers of module '$alt' (alias variant) =="
      node "$REAL_CLI" references "$alt" --module "${dbarg[@]}" 2>&1 || true
    fi
  else
    # bare symbol -> alias-agnostic symbol mode (README: symbol mode is alias-agnostic)
    echo "== importers of symbol '$target' (alias-agnostic) =="
    node "$REAL_CLI" references "$target" "${dbarg[@]}" 2>&1 || true
  fi
  exit 0
fi

if [ "$SUBCMD" = "leaks" ]; then
  maybe_reindex
  pkg="${2:-$DIR}"
  echo "== reverse (shared->app) '@/' imports under: $pkg ==" >&2
  hits="$(grep -rnE "(import|export)[^;]*from[[:space:]]*['\"]@/" "$pkg" \
            --include='*.ts' --include='*.tsx' --include='*.vue' 2>/dev/null \
            | grep -v '/node_modules/')" || true
  if [ -z "$hits" ]; then
    echo "(none — shared layer is clean)"
  else
    echo "$hits"
  fi
  exit 0
fi

maybe_reindex
exec node "$REAL_CLI" "$@"
