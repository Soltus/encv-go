#!/usr/bin/env bash
# scripts/test-frontend.sh-changed
# =====================================================
# 🆕 2026-07-02 真正的"改完继续"：用 git diff 找改动文件 → 映射测试 → 直接调 vitest run
#
# 为什么不用 vitest --changed：monorepo 子目录下 --changed 路径对不上，
# 导致每次都跑全部。不如自己用 git diff 精确匹配。
#
# 用法：
#   bash scripts/test-frontend.sh-changed                 # 自上次 commit 以来改动的
#   bash scripts/test-frontend.sh-changed --staged        # git staged 改动的
#   bash scripts/test-frontend.sh-changed src/foo.ts      # 指定文件（不用 git diff）
#
# 性能：
#   - 改 1-3 个相关文件 → 1-3 个测试文件 → ~2-5s
#   - 全量 → 55 文件 → ~60s（happy-dom + threads）
# =====================================================

set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
MOBILE_DIR="$ROOT/app/encv-mobile"

if [ ! -f "$MOBILE_DIR/package.json" ]; then
  echo "FATAL: $MOBILE_DIR/package.json not found" >&2
  exit 70
fi
cd "$MOBILE_DIR"

# ── 收集改动文件列表 ──
CHANGED_FILES=""
if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
  # 直接传文件路径
  CHANGED_FILES="$*"
elif [ "${1:-}" = "--staged" ]; then
  CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '^app/encv-mobile/' | sed 's|^app/encv-mobile/||')
else
  # 默认：unstaged + staged
  CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR 2>/dev/null | grep '^app/encv-mobile/' | sed 's|^app/encv-mobile/||')
  if [ -z "$CHANGED_FILES" ]; then
    CHANGED_FILES=$(git diff HEAD --name-only --diff-filter=ACMR 2>/dev/null | grep '^app/encv-mobile/' | sed 's|^app/encv-mobile/||')
  fi
fi

if [ -z "$CHANGED_FILES" ]; then
  echo "==> No changed files detected. Running smoke test (useSearchInput)..."
  exec npx vitest run src/composables/__tests__/useSearchInput.test.ts
fi

echo "==> Changed files:"
echo "$CHANGED_FILES" | sed 's/^/  /'

# ── 映射：改动文件 → 测试文件 ──
TEST_FILES=""
add_test_file() {
  local f="$1"
  [ -f "$f" ] || return 1
  # 去重
  echo " $TEST_FILES " | grep -q " $f " && return 0
  TEST_FILES="${TEST_FILES:+$TEST_FILES }$f"
  return 0
}

for f in $CHANGED_FILES; do
  base=$(basename "$f" | sed 's/\.\(ts\|vue\)$//')
  dir=$(dirname "$f")

  # 1. 精确测试文件
  [ -f "$dir/__tests__/${base}.test.ts" ] && add_test_file "$dir/__tests__/${base}.test.ts"
  [ -f "$dir/${base}.test.ts" ] && add_test_file "$dir/${base}.test.ts"
  [ -f "$dir/__tests__/${base}.test.vue" ] && add_test_file "$dir/__tests__/${base}.test.vue"

  # 2. composable: useFoo.ts → useFoo*.test.ts（可能有多个测试文件）
  if [[ "$base" =~ ^use[A-Z] ]]; then
    while IFS= read -r tf; do
      [ -n "$tf" ] && add_test_file "$tf"
    done < <(find src/composables -maxdepth 2 -name "${base}*.test.ts" 2>/dev/null)
  fi

  # 3. view: Foo.vue → useFoo 相关测试（间接依赖）
  if [[ "$f" == src/views/* ]]; then
    # 提取视图名 → 找对应 composable 测试
    name=$(echo "$base" | sed -E 's/(^|[A-Z])/ \1/g' | xargs | tr ' ' '_' | tr '[:upper:]' '[:lower:]')
    # 简单策略：找文件名含 use+BaseName 的测试
    while IFS= read -r tf; do
      [ -n "$tf" ] && add_test_file "$tf"
    done < <(find src/composables -maxdepth 2 -name "*.test.ts" 2>/dev/null | xargs grep -l "$base" 2>/dev/null || true)
  fi

  # 4. lib/ 目录：改了 lib/x.ts → 跑 lib/__tests__/ 下所有测试
  if [[ "$dir" == src/lib/* ]]; then
    while IFS= read -r tf; do
      [ -n "$tf" ] && add_test_file "$tf"
    done < <(find "$dir" -name "*.test.ts" 2>/dev/null)
  fi
done

if [ -z "$TEST_FILES" ]; then
  echo ""
  echo "==> No test files mapped from changed files."
  echo "==> Running smoke test as fallback..."
  exec npx vitest run src/composables/__tests__/useSearchInput.test.ts
fi

COUNT=$(echo "$TEST_FILES" | wc -w | xargs)
echo ""
echo "==> Running $COUNT test file(s):"
echo "$TEST_FILES" | tr ' ' '\n' | sed 's/^/  /'
echo ""

# 直接调 vitest run（vitest 命令本身）
exec npx vitest run $TEST_FILES
