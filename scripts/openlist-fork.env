# scripts/openlist-fork.env
# =============================================================================
# Centralised fork configuration consumed by build-openlist-aar.sh and the
# PowerShell counterpart build-openlist-aar.ps1.
#
# The build scripts `source` this file on every invocation. CLI flags still win
# over anything declared here.
#
# To override a value locally without editing this tracked file, create
# `scripts/openlist-fork.env.local` (gitignored) and export the same variables
# in your shell rc, or copy this file next to it and edit there.
# =============================================================================

OPENLIST_FORK_URL=https://github.com/Hi-Sillot/OpenList.git
OPENLIST_FORK_BRANCH=dev
OPENLIST_FORK_PINNED_TAG=
OPENLIST_FRONTEND_VERSION=v4.1.8
