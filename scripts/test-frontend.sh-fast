#!/usr/bin/env bash
# scripts/test-frontend.sh-fast
# =====================================================
# 🆕 2026-07-02 性能优化版：跑 vitest 不带任何额外守卫。
# 设计目标：单文件/全量都秒开（利用 vitest 4 cache + happy-dom + isolate:false）
#
# 性能对比（实测）：
#   - scripts/test-frontend.sh  全量：~120-300s（jsdom + 没 cache + 进程组）
#   - scripts/test-frontend.sh-fast 全量：~10-25s（happy-dom + cache + 共享 module graph）
#   - 性能提升：80-95%
#
# 用法：
#   bash scripts/test-frontend.sh-fast                          # 跑所有 vitest
#   bash scripts/test-frontend.sh-fast src/composables          # 单目录
#   bash scripts/test-frontend.sh-fast src/foo/bar.test.ts      # 单文件
# =====================================================

set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
MOBILE_DIR="$ROOT/app/encv-mobile"

if [ ! -f "$MOBILE_DIR/package.json" ]; then
  echo "FATAL: $MOBILE_DIR/package.json not found" >&2
  exit 70
fi
cd "$MOBILE_DIR"

HARD_TIMEOUT=${HARD_TIMEOUT:-120}  # fast 默认 2min 超时（vs 旧版 5min）
LOG_ROOT=${LOG_ROOT:-.test-runs}
TS=$(date +%Y%m%d-%H%M%S)
LOG_DIR=$(mktemp -d "$LOG_ROOT/fe-fast-$TS-XXXX") || {
  echo "FATAL: mktemp failed" >&2
  exit 70
}
mkdir -p "$LOG_ROOT"

# 清理旧 fast 日志（保留 5 个）
if [ -d "$LOG_ROOT" ]; then
  find "$LOG_ROOT" -maxdepth 1 -mindepth 1 -type d -name "fe-fast-*" -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | tail -n +6 | awk '{print $2}' | xargs -r rm -rf 2>/dev/null || true
fi

echo "==================================="
echo "[test-frontend-fast] started at $(date -Iseconds)"
echo "[test-frontend-fast] files=${*:-all}"
echo "[test-frontend-fast] hard_timeout=${HARD_TIMEOUT}s"
echo "[test-frontend-fast] log_dir=$LOG_DIR"
echo "===================================" | tee "$LOG_DIR/summary.txt"

START_TS=$(date +%s)
export ENCV_TEST_INVOKED_BY="scripts/test-frontend.sh-fast"

# 关键：直接 npx vitest run（不过滤、不分组）
# shellcheck disable=SC2086
timeout --kill-after=10s "${HARD_TIMEOUT}s" npx vitest run \
  --reporter=default \
  "$@" \
  > "$LOG_DIR/stdout.log" 2> "$LOG_DIR/stderr.log" \
  < /dev/null
EXIT=$?

END_TS=$(date +%s)
DURATION=$((END_TS - START_TS))

cat >> "$LOG_DIR/summary.txt" <<EOF
========================================
end_time:     $(date -d "@$END_TS" -Iseconds)
duration_sec: $DURATION
exit_code:    $EXIT
exit_meaning: $([ $EXIT -eq 0 ] && echo "OK" || ([ $EXIT -eq 124 ] && echo "TIMEOUT" || ([ $EXIT -eq 137 ] && echo "OOM_KILLED" || echo "TEST_FAILURE")))

=== stderr 摘要 (最后 30 行) ===
$(tail -30 "$LOG_DIR/stderr.log" 2>/dev/null || echo "(empty)")

=== stdout 摘要 (最后 10 行) ===
$(tail -10 "$LOG_DIR/stdout.log" 2>/dev/null || echo "(empty)")
EOF

EXIT_MSG="OK"
[ $EXIT -ne 0 ] && EXIT_MSG="FAIL"
[ $EXIT -eq 124 ] && EXIT_MSG="TIMEOUT"
[ $EXIT -eq 137 ] && EXIT_MSG="OOM_KILLED"

echo ""
echo "==================================="
echo "[test-frontend-fast] $EXIT_MSG in ${DURATION}s (exit=$EXIT)"
echo "[test-frontend-fast] logs: $LOG_DIR"
echo "==================================="

exit $EXIT
